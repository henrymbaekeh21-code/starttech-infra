{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "ALB Request Count",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ApplicationELB", "RequestCount", "LoadBalancer", "{ALB_ARN_SUFFIX}"]
        ],
        "period": 300,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Response Time (p99)",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ApplicationELB", "TargetResponseTime", "LoadBalancer", "{ALB_ARN_SUFFIX}", { "stat": "p99" }]
        ],
        "period": 300
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Healthy Hosts",
        "region": "us-east-1",
        "metrics": [
          ["AWS/ApplicationELB", "HealthyHostCount", "TargetGroup", "{TG_ARN_SUFFIX}", "LoadBalancer", "{ALB_ARN_SUFFIX}"]
        ],
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "ASG Instance Count",
        "region": "us-east-1",
        "metrics": [
          ["AWS/AutoScaling", "GroupInServiceInstances", "AutoScalingGroupName", "{ASG_NAME}"],
          [".", "GroupDesiredCapacity", ".", "."],
          [".", "GroupMinSize", ".", "."],
          [".", "GroupMaxSize", ".", "."]
        ],
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "CPU Utilization",
        "region": "us-east-1",
        "metrics": [
          ["AWS/EC2", "CPUUtilization", "AutoScalingGroupName", "{ASG_NAME}"]
        ],
        "period": 300,
        "stat": "Average"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 12,
      "width": 24,
      "height": 8,
      "properties": {
        "title": "Application Logs",
        "region": "us-east-1",
        "query": "SOURCE '/starttech/production/backend' | fields @timestamp, @message | sort @timestamp desc | limit 100"
      }
    }
  ]
}
